{
  "app": {
    "name": "Market-AI-Prediction",
    "default_market": "merval",
    "timezone": "UTC"
  },
  "paths": {
    "datos": "datos",
    "modelos": "modelos",
    "reportes": "reportes",
    "logs": "logs"
  },
  "pipeline": {
